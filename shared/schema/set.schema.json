{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instrument-hub.local/schema/set.schema.json",
  "title": "Instrument Hub set mapping",
  "description": "The hot-reloadable set mapping for the eight-track performance grid. Tracks are columns; pads select tracks, toggle hot FX and set volume steps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layout", "tracks", "pads"],
  "properties": {
    "schemaVersion": {
      "description": "Document format version. Only version 2 is accepted.",
      "const": 2
    },
    "layout": {
      "const": "tracks"
    },
    "name": {
      "description": "Human-readable set name.",
      "type": "string",
      "minLength": 1
    },
    "tracks": {
      "description": "Eight performance tracks, one per grid column.",
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/track" }
    },
    "macros": {
      "description": "Optional named encoder destinations, keyed by macro id.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/macro" }
    },
    "banks": {
      "description": "Top-row macro pages, keyed by bank index (Launchpad CC 91..98). Optional; when present bank 0 is the leftmost button.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/bank" }
    },
    "scenes": {
      "description": "Right-column scenes, keyed by scene index (Launchpad CC 89..19, top to bottom). Optional.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/scene" }
    },
    "pads": {
      "description": "Track pad roles: row 7 selects a track, rows 6/5 toggle hot FX 0/1, rows 4..0 select volume steps.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/padTrack" },
          { "$ref": "#/$defs/padFx" },
          { "$ref": "#/$defs/padVolume" }
        ]
      }
    },
    "encoders": {
      "description": "Optional encoder bindings.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/encoder" }
    }
  },
  "$defs": {
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameter"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "description": "Opaque parameter path resolved by the audio layer (for example filter.cutoff).",
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number",
          "default": 0.0
        },
        "max": {
          "type": "number",
          "default": 1.0
        },
        "default": {
          "type": "number"
        }
      }
    },
    "encoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoder", "macro"],
      "properties": {
        "encoder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "macro": {
          "description": "Must match a key in macros.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "name", "macros"],
      "properties": {
        "bank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "macros": {
          "description": "Macro ids exposed while this page is selected.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "name"],
      "properties": {
        "scene": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trackReference": {
      "description": "Track id, or the track slot (0..7).",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      ]
    },
    "padTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pad", "role", "track"],
      "properties": {
        "pad": {
          "type": "integer",
          "minimum": 56,
          "maximum": 63
        },
        "role": {
          "const": "track"
        },
        "track": { "$ref": "#/$defs/trackReference" }
      }
    },
    "padFx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pad", "role", "track", "hot"],
      "properties": {
        "pad": {
          "type": "integer",
          "minimum": 40,
          "maximum": 55
        },
        "role": {
          "const": "fx"
        },
        "track": { "$ref": "#/$defs/trackReference" },
        "hot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "padVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pad", "role", "track", "step"],
      "properties": {
        "pad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 39
        },
        "role": {
          "const": "volume"
        },
        "track": { "$ref": "#/$defs/trackReference" },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slot"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "hotFx": {
          "description": "Up to two insert ids from the track instrument's FX chain.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
