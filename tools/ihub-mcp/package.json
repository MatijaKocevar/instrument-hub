{
  "name": "@instrument-hub/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol adapter for the Instrument Hub control API.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ihub-mcp": "dist/index.js"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../shared/api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "openapi-typescript ../../shared/api/openapi.yaml -o src/api/schema.d.ts && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "openapi-fetch": "0.17.0",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
