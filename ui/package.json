{
  "name": "instrument-hub-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "description": "Instrument Hub React UI, embedded in the JUCE engine.",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../shared/api/openapi.yaml -o src/api/schema.d.ts",
    "build": "openapi-typescript ../shared/api/openapi.yaml -o src/api/schema.d.ts && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
